# ---- Gmail tester inbox (IMAP) ----
# Use a Google App Password, NOT your normal password.
# Enable 2FA on the account, then: https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-tester@gmail.com
IMAP_PASSWORD=your_16_char_app_password

# ---- Dashboard access ----
# Password the App Store reviewer types to open the dashboard.
DASHBOARD_PASSWORD=set-a-strong-shared-password
# Secret used to sign the login session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# ---- OTP extraction (optional tuning) ----
# Only show emails whose "from" contains this (substring match). Leave blank to allow any sender.
OTP_FROM=
# Only show emails whose subject contains this (case-insensitive). Leave blank to allow any subject.
OTP_SUBJECT=
# Regex (first capture group) used to pull the code out of the email body. Default: 4-8 digit code.
OTP_REGEX=\b(\d{4,8})\b
# Only consider emails received within this many minutes. Default 15.
OTP_WINDOW_MINUTES=15
# How many recent inbox messages to scan each refresh.
OTP_SCAN_COUNT=15
